        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var grp = new GlideRecord('sys_user_group');
    if (grp.get('name', 'Retail Escalation Desk')) {
        current.assignment_group = grp.getUniqueValue();
    }

    // Inherit assigned_to from parent complaint if available
    var parentId = current.parent || current.parent_complaint;
    if (parentId && current.assigned_to.nil()) {
        var parentGr = new GlideRecord('x_1958581_retail_0_retail_complaint');
        if (parentGr.get(parentId) && !parentGr.assigned_to.nil()) {
            current.assigned_to = parentGr.assigned_to;
        }
    }
})(current, previous);
]]></script>
